# PRAKRITI AI Environment Configuration
# Copy this file to .env and configure your settings

# Online AI Provider Configuration
VITE_AI_PROVIDER=mock
# Options: mock, openai, custom

VITE_AI_API_URL=http://localhost:11434
VITE_AI_API_KEY=
VITE_AI_MODEL=gpt-4

# Voice Configuration
VITE_STT_PROVIDER=webspeech
# Options: webspeech, whisper

VITE_TTS_PROVIDER=webspeech
# Options: webspeech, piper

# Offline AI Configuration
VITE_OFFLINE_AI_URL=http://localhost:11434
VITE_OFFLINE_AI_MODEL=llama2

# Vision/OCR Configuration
VITE_OCR_PROVIDER=tesseract
# Options: tesseract, online